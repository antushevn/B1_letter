ANTHROPIC_API_KEY=sk-ant-...

# Optional: durable history storage. When set, attempts are stored in MongoDB
# (survives restarts / ephemeral hosting) instead of the local data/history.jsonl
# file. Leave unset for a purely local, file-based setup.
# MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/
# MONGO_DB=b1_trainer   # optional; database name (defaults to b1_trainer)
